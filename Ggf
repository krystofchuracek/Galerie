<!DOCTYPE html>
<html lang="cs"><head><meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Galerie, kterou si zahraješ</title>
<style>
:root{--wall:#10161d;--spot:#32465a;--ink:#eef1f3;--mute:#a4b3bf;--card:#18212b;--line:#2f3d4a;--gold:#d9b85f;--ok:#79c79a;--bad:#ee8d78;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media(prefers-color-scheme:dark){:root:not([data-theme=light]){--wall:#10161d}}
@media(prefers-color-scheme:light){:root:not([data-theme=dark]){--wall:#dde2e6;--spot:#fff;--ink:#17202a;--mute:#4f5e6b;--card:#f3f5f6;--line:#bcc7cf;--gold:#8a6a1e;--ok:#1f6a47;--bad:#a23b2a}}
:root[data-theme=light]{--wall:#dde2e6;--spot:#fff;--ink:#17202a;--mute:#4f5e6b;--card:#f3f5f6;--line:#bcc7cf;--gold:#8a6a1e;--ok:#1f6a47;--bad:#a23b2a}
*{box-sizing:border-box}html{scroll-padding-top:env(safe-area-inset-top,0px)}
body{margin:0;min-height:100vh;color:var(--ink);font:17px/1.55 system-ui,-apple-system,"Segoe UI",sans-serif;background:radial-gradient(ellipse 90% 55% at 50% -5%,var(--spot),transparent 70%),var(--wall) fixed}
main{max-width:660px;margin:0 auto;padding:22px 16px 56px}
h1,h2,.serif{font-family:"Iowan Old Style","Palatino Linotype",Palatino,Georgia,serif}
h1{font-size:clamp(2.4rem,11vw,3.6rem);line-height:1.02;margin:.1em 0 .35em;font-weight:700;letter-spacing:-.01em}
h2{font-size:1.4rem;line-height:1.25;margin:.2em 0 .7em;font-weight:600}
.rooms{display:flex;gap:6px;margin-bottom:6px}.rm{flex:1;height:7px;border-radius:2px;background:var(--line)}.rm.on{background:var(--gold)}.rm.ok{background:var(--ok)}.rm.no{background:var(--bad)}
.meta{color:var(--mute);font-size:.92rem;margin-bottom:16px}
figure{margin:0 0 6px}figure.p{max-width:340px;margin-left:auto;margin-right:auto}
.frame{padding:11px;border-radius:3px;background:linear-gradient(135deg,#ecd48e,#9a7627 35%,#f2dfa6 55%,#7d5d1c 80%,#caa44c);box-shadow:0 22px 44px #0007,inset 0 1px 0 #fff6}
.mat{padding:7px;background:#ece7da;box-shadow:inset 0 0 0 1px #0003}
.pic{position:relative;line-height:0;box-shadow:0 0 0 1px #0005,inset 0 0 14px #0006}
.pic img{display:block;width:100%;height:auto}
.hot .pic{cursor:crosshair}
.ring{position:absolute;width:44px;height:44px;margin:-22px 0 0 -22px;border-radius:50%;border:3px solid #fff;box-shadow:0 0 0 2px #0008,0 0 12px #0008;pointer-events:none}
.ring.ok{border-color:#79e0a4;width:60px;height:60px;margin:-30px 0 0 -30px}.ring.no{border-color:#ff8f78}
.plc{background:#f1eee6;color:#1d1a14;font:.82rem/1.4 Georgia,serif;padding:9px 13px;margin:14px auto 0;max-width:420px;border-radius:2px;box-shadow:0 5px 14px #0006}
.plc b{font-size:.95rem}.plc a{color:#27476e}.take a{color:var(--gold);word-break:break-all}
.pair{display:grid;grid-template-columns:1fr 1fr;gap:12px}.pair .frame{padding:6px}.pair .mat{padding:4px}.pair .plc{font-size:.7rem;padding:7px 8px}
.qa{margin-top:22px}
.opt{display:flex;gap:13px;align-items:flex-start;width:100%;text-align:left;font:inherit;color:inherit;background:var(--card);border:1.5px solid var(--line);border-radius:10px;padding:13px 14px;margin:9px 0;cursor:pointer;transition:border-color .15s,transform .1s}
.opt:hover:not(:disabled){border-color:var(--gold)}.opt:active:not(:disabled){transform:scale(.99)}
.opt .lt{flex:none;width:28px;height:28px;border-radius:50%;border:1.5px solid var(--gold);color:var(--gold);display:grid;place-items:center;font:700 .85rem Georgia,serif}
.opt.ok{border-color:var(--ok);background:color-mix(in srgb,var(--ok) 16%,var(--card))}.opt.ok .lt{background:var(--ok);border-color:var(--ok);color:var(--wall)}
.opt.no{border-color:var(--bad);opacity:.75;background:color-mix(in srgb,var(--bad) 12%,var(--card))}
.opt:focus-visible,.btn:focus-visible{outline:3px solid var(--gold);outline-offset:2px}
.btn{font:700 1rem system-ui,sans-serif;background:var(--gold);color:#14110a;border:0;border-radius:10px;padding:14px 24px;margin-top:14px;cursor:pointer;box-shadow:0 6px 16px #0004}
.fb{margin-top:14px;padding:13px 15px;border-radius:10px;background:var(--card);border:1.5px solid var(--line);border-left-width:5px}
.fb.ok{border-color:var(--ok)}.fb.no{border-color:var(--bad)}.fb b{font-family:Georgia,serif}
.hang{display:flex;justify-content:center;align-items:flex-end;gap:12px;margin:26px 0 22px}
.hang .frame{width:31%;padding:5px}.hang .mat{padding:3px}.hang img{height:130px;object-fit:cover;width:100%}
.hang .frame:nth-child(1){transform:rotate(-2deg)}.hang .frame:nth-child(3){transform:rotate(2deg)}
.rules{padding:0;list-style:none;margin:0}.rules li{padding:10px 0;border-top:1px solid var(--line)}
.ticket{margin:18px 0;padding:22px 20px;background:#f1eee6;color:#1d1a14;border-radius:6px;text-align:center;font-family:Georgia,serif;box-shadow:0 12px 30px #0006;border:2px dashed #8a7a55}
.ticket .big{font-size:4.2rem;line-height:1;font-weight:700}
.dots{display:flex;gap:8px;justify-content:center;flex-wrap:wrap;margin-top:12px;font:.78rem system-ui}.dots span{padding:4px 9px;border-radius:99px;background:#d8d2c0}.dots .y{background:#2d6a4f;color:#fff}
.take{background:var(--card);border:1.5px solid var(--line);border-radius:10px;padding:13px 15px;margin:10px 0}
.hud{display:flex;justify-content:space-between;align-items:center;margin:14px 0 0;padding:9px 14px;border-radius:10px;background:var(--card);border:1.5px solid var(--line);font:700 .95rem Georgia,serif}.hud span:last-child{color:var(--gold)}.btn.alt{background:transparent;color:var(--gold);border:1.5px solid var(--gold);box-shadow:none}.btn.sm{padding:9px 18px;margin-top:6px;font-size:.9rem}.btn:disabled{opacity:.4;cursor:not-allowed}.item{display:grid;grid-template-columns:96px 1fr;gap:14px;background:var(--card);border:1.5px solid var(--line);border-radius:10px;padding:12px;margin:12px 0}.item.own{border-color:var(--ok)}.item img{width:96px;height:96px;object-fit:cover;box-shadow:0 0 0 4px #b8932f,0 6px 14px #0006}.price{font:700 1.05rem Georgia,serif;color:var(--gold)}@media(prefers-reduced-motion:reduce){*{transition:none!important}}
</style></head><body><main id="app"></main>
<script>
var IMG={f:"data:image/jpeg;base64,",m:"data:image/jpeg;base64,",t:"data:image/jpeg;base64,"};
var ART={f:["C. D. Friedrich","Poutník nad mořem mlhy","kolem 1817","Hamburger Kunsthalle","https://hamburger-kunsthalle.de/en/nineteenth-century"],m:["J.-F. Millet","Sběračky klasů","1857","Musée d’Orsay, Paříž","https://www.musee-orsay.fr/it/opere/des-glaneuses-342"],t:["J. M. W. Turner","Déšť, pára a rychlost","1844","National Gallery, Londýn","https://www.nationalgallery.org.uk/paintings/joseph-mallord-william-turner-rain-steam-and-speed-the-great-western-railway"]};
var T=[
{n:"Poznej směr",img:["t"],q:'Turner maluje parní lokomotivu, tedy novinku své doby. Přesto jde o romantismus. Proč?',
o:['Obraz předává sílu přírody a dojem rychlosti rozpitou barvou a světlem, ne přesným popisem','Moderní věci směli malovat jen romantici','Na obraze je málo postav, a proto jde o romantismus','Realismus technikou nesměl nikdy zobrazovat'],c:0,
hint:'Téma samo o směru nerozhoduje. Podívej se, jak je obraz namalovaný a co z něj cítíš.',
why:'Romantik nehledá přesný záznam, ale silný dojem. Mlha, déšť a světlo splývají a stroj je jen jedním z živlů. Moderní téma by klidně mohl malovat i realista, ten by ho ale popsal věcně.'},
{n:"Najdi detail",img:["m"],hot:{x:.936,y:.32,r:.075},q:'Klikni na postavu, která na sběračky dohlíží.',
hint:'Dívej se do pozadí. Hledej jezdce na obzoru vpravo nahoře.',
why:'Je to jezdec na koni, podle Musée d’Orsay pravděpodobně správce statku, který nad sklizní dohlíží. Je daleko za třemi sklánějícími se ženami. Millet záměrně staví nejchudší ženy v popředí proti stohům a dozoru bohatého statku v dálce.'},
{n:"Porovnej",img:["f","m"],q:'Co mají tyto dva obrazy překvapivě společného a v čem se zásadně liší?',
o:['Obě hlavní postavy nám skrývají tvář a vedou pohled do dálky. Friedrich z toho dělá prožitek vznešena, Millet tíhu práce.','Oba zobrazují chudé rolníky při práci, liší se jen barvami.','Oba jsou romantické, protože jsou z 19. století.','Friedrich maluje detailně a přesně, Millet jen náladu.'],c:0,
hint:'Všimni si, kam se postavy dívají a kde mají obličej. Pak řeš, co z toho má divák cítit.',
why:'Skrytá tvář dělá z postavy zástupce všech. U Friedricha se do něj můžeme vcítit a spolu s ním žasnout, u Milleta vidíme zad, který bolí. Je to stejný prostředek s opačným významem.'},
{n:"Pochop pojem",img:["t"],q:'Jak Turner vede pohled a vytváří dojem rychlosti? Vyber nejpřesnější popis kompozice.',
o:['Koleje se šikmo zužují k lokomotivě a kontury mizí v mlze, oko je tedy taženo do hloubky','Obraz je přísně symetrický a klidný, vše je v rovnováze','Všechny tvary mají ostré obrysy a stejnou barvu','Vodorovné pruhy dělí obraz na tři klidné části'],c:0,
hint:'Sleduj čáry kolejí. Kam míří a co se děje s ostrostí tvarů vzdalováním?',
why:'Šikmá linie kolejí (diagonála) dává pohyb, rozpité okraje zdůrazňují rychlost a atmosféru. Diagonála vede pohled od diváka přímo do tmavého bodu lokomotivy.'},
{n:"Oprav omyl",img:["t"],q:'Který z výroků je nepravdivý?',
o:['Poutník stojí zády k divákovi, aby se divák mohl s postavou ztotožnit.','Millet maloval ženy, které sbírají zbytky po sklizni, tedy nejchudší vrstvu.','Realisté chtěli zobrazovat hlavně historické hrdiny a mytologické scény.','Romantici často zdůrazňovali pocity a sílu přírody.'],c:2,
hint:'Hledej výrok, který si protiřečí s tím, co víš o Milletovi.',
why:'Pravda je opačná: realisté odmítali hrdiny a mýty a chtěli ukázat obyčejný současný život, třeba rolníky a dělníky.'}];
var i=-1,tries=0,res=[],pts=0,streak=0,owned={},earned=[],app=document.getElementById("app");
var P={m:[200,'Obraz z roku 1857 pobouřil část vyšší společnosti, protože dal nejchudším ženám monumentální důstojnost.'],t:[300,'Lokomotiva přejíždí železniční most v Maidenheadu přes Temži. Turner tedy zachytil opravdovou novinku své doby, železnici společnosti Great Western Railway.'],f:[400,'Podle většiny výkladů je krajina složená ze skal z různých míst Saského Švýcarska. Není to jediný skutečný výhled, ale vymyšlený prožitek.']};
function $(s){return document.getElementById(s)}
function shuf(a){a=a.slice();for(var k=a.length-1;k>0;k--){var j=Math.floor(Math.random()*(k+1)),x=a[k];a[k]=a[j];a[j]=x}return a}
function plc(k){var a=ART[k];return '<div class="plc"><b>'+a[0]+'</b><br><i>'+a[1]+'</i>, '+a[2]+'<br>Sbírka: '+a[3]+'<br>Zdroj: <a href="'+a[4]+'" target="_blank" rel="noopener">'+a[4].split('/')[2]+'</a></div>'}
function fig(k,hot){return '<figure class="'+(k=="f"?"p":"")+'"><div class="frame"><div class="mat"><div class="pic" id="pic"><img id="im" src="'+IMG[k]+'" alt="'+ART[k][1]+'"></div></div></div>'+plc(k)+'</figure>'}
function rooms(){var h='<div class="rooms">';for(var k=0;k<T.length;k++)h+='<div class="rm '+(res[k]===true?'ok':res[k]===false?'no':k==i?'on':'')+'"></div>';return h+'</div><div class="hud"><span>Body</span><span id="pts">'+pts+'</span></div>'}
function intro(){i=-1;res=[];pts=0;streak=0;owned={};earned=[];T.forEach(function(t){delete t.ord});
app.innerHTML='<div class="meta serif">Virtuální výstava</div><h1>Galerie, kterou si zahraješ</h1><div class="hang">'+['f','t','m'].map(function(k){return '<div class="frame"><div class="mat"><img src="'+IMG[k]+'" alt=""></div></div>'}).join('')+'</div><p>Projdi pět sálů a u tří skutečných obrazů zjisti, jak se romantismus a realismus dívají na člověka a přírodu. Zabere to asi 5 minut. Pozor, otázky nejsou jen na pozornost, někde budeš muset přemýšlet.</p><ul class="rules"><li>V každém sále je jeden úkol.</li><li>Při chybě dostaneš nápovědu a zkusíš to znovu, ale ztratíš část bodů.</li><li>Po správné odpovědi se dozvíš, proč je správná.</li><li>Body: 100 za správnou odpověď napoprvé, 50 napodruhé, 25 potřetí. Za sérii správných odpovědí napoprvé je bonus navíc.</li><li>Na konci utratíš body v galerijním obchodě za obrazy do své sbírky. Koupit nepůjde všechno, budeš si muset vybrat.</li></ul><button class="btn" id="go">Vstoupit do galerie</button>';$('go').onclick=next}
function next(){i++;if(i>=T.length)return end();tries=0;var t=T[i];window.scrollTo(0,0);
var pics=t.img.length>1?'<div class="pair">'+t.img.map(function(k){return '<div>'+fig(k)+'</div>'}).join('')+'</div>':fig(t.img[0]);
app.innerHTML=rooms()+'<div class="meta">Sál '+(i+1)+' z '+T.length+': '+t.n+'</div><div class="'+(t.hot?'hot':'')+'">'+pics+'</div><div class="qa"><h2>'+t.q+'</h2><div id="opts"></div><div id="fb" aria-live="polite"></div></div>';
if(t.hot){$('pic').onclick=click;$('fb').innerHTML='<div class="fb">Klepni přímo na obraz.</div>'}
else{if(!t.ord)t.ord=shuf(t.o.map(function(x,j){return j}));t.ord.forEach(function(j,p){var b=document.createElement("button");b.className="opt";b.innerHTML='<span class="lt">'+"ABCD"[p]+'</span><span>'+t.o[j]+'</span>';b.onclick=function(){pick(b,j)};$('opts').appendChild(b)})}}
function done(ok){res[i]=(tries==1);var g=tries==1?100:tries==2?50:25;if(tries==1){streak++;g+=streak*10}else streak=0;pts+=g;earned[i]=g;$('pts').textContent=pts;var all=document.querySelectorAll(".opt");[].forEach.call(all,function(e){e.disabled=true});
$('fb').innerHTML='<div class="fb ok"><b>Správně, +'+g+' bodů.</b> '+T[i].why+'</div><button class="btn" id="nx">'+(i<T.length-1?"Do dalšího sálu":"K závěru")+'</button>';$('nx').onclick=next;
var r=document.querySelector('.rm.on');if(r)r.className='rm '+(res[i]?'ok':'no')}
function pick(b,j){tries++;if(j==T[i].c){b.classList.add("ok");done()}else{b.classList.add("no");b.disabled=true;$('fb').innerHTML='<div class="fb no"><b>Zatím ne.</b> '+T[i].hint+' Zkus to znovu.</div>'}}
function click(e){var t=T[i],h=t.hot,im=$('im'),p=$('pic');if(p.dataset.d)return;var r=im.getBoundingClientRect(),px=e.clientX-r.left,py=e.clientY-r.top;tries++;
var d=Math.hypot(px-h.x*r.width,py-h.y*r.height),ok=d<h.r*r.width;
var ring=document.createElement("div");ring.className="ring "+(ok?"ok":"no");ring.style.left=(ok?h.x*r.width:px)+"px";ring.style.top=(ok?h.y*r.height:py)+"px";p.appendChild(ring);
if(ok){p.dataset.d=1;p.style.cursor="default";done()}else{setTimeout(function(){ring.remove()},900);$('fb').innerHTML='<div class="fb no"><b>Tady ne.</b> '+t.hint+'</div>'}}
function end(){i=T.length;var sc=res.filter(Boolean).length;window.scrollTo(0,0);
app.innerHTML=rooms()+'<h1>Konec prohlídky</h1><div class="ticket"><div>Získané body</div><div class="big">'+earned.reduce(function(a,b){return a+(b||0)},0)+'</div><div>Napoprvé správně: '+sc+' z '+T.length+'</div><div class="dots">'+T.map(function(t,k){return '<span class="'+(res[k]?'y':'')+'">'+t.n+'</span>'}).join('')+'</div></div><h2>Co sis odnesl</h2><div class="take"><b>Romantismus</b> hledá silný dojem a vznešenost. Postava je často sama a příroda je větší než ona (Friedrich, Turner).</div><div class="take"><b>Realismus</b> ukazuje obyčejný život a práci bez zkrášlení a bez hrdinských póz (Millet).</div><div class="take">Stejný prostředek, třeba skrytá tvář nebo diagonála, může mít v každém směru jiný význam.</div><h2>Zdroje</h2>'+['m','t','f'].map(function(k){var a=ART[k];return '<div class="take">'+a[0]+', <i>'+a[1]+'</i>, '+a[2]+', '+a[3]+'<br><small><a href="'+a[4]+'" target="_blank" rel="noopener">'+a[4]+'</a></small></div>'}).join('')+'<button class="btn" id="shop">Do galerijního obchodu</button> <button class="btn alt" id="re">Hrát znovu</button>';$('shop').onclick=shop;$('re').onclick=intro}
function shop(){window.scrollTo(0,0);var h='<h1>Galerijní obchod</h1><p>Utrať body za obrazy do své sbírky. Je to jen hra, žádné skutečné peníze. Všechno koupit nepůjde, vybírej s rozmyslem.</p><div class="hud"><span>Zůstatek</span><span>'+pts+' bodů</span></div>';['m','t','f'].forEach(function(k){var a=ART[k],p=P[k];h+='<div class="item'+(owned[k]?' own':'')+'"><img src="'+IMG[k]+'" alt=""><div><b class="serif">'+a[1]+'</b><br><small>'+a[0]+', '+a[2]+'</small><br>'+(owned[k]?'<small><b>Ve tvé sbírce.</b> '+p[1]+'</small>':'<span class="price">'+p[0]+' bodů</span><br><button class="btn sm" data-k="'+k+'"'+(pts<p[0]?' disabled':'')+'>Koupit</button>')+'</div></div>'});h+='<button class="btn alt" id="bk">Zpět na výsledek</button> <button class="btn" id="re2">Hrát znovu</button>';app.innerHTML=h;[].forEach.call(document.querySelectorAll('[data-k]'),function(b){b.onclick=function(){var k=b.dataset.k;pts-=P[k][0];owned[k]=1;shop()}});$('bk').onclick=end;$('re2').onclick=intro}
intro();
</script></body></html>
